{
  "manifest_version": 3,
  "name": "deCDN links",
  "version": "0.2.0",
  "description": "Opens decdn: links and media through your local decdn gateway.",
  "permissions": ["storage", "declarativeNetRequest"],
  "host_permissions": ["http://127.0.0.1/*", "http://localhost/*", "https://up.decdn.org/*"],
  "background": {
    "service_worker": "background.js",
    "scripts": ["background.js"]
  },
  "action": {
    "default_title": "deCDN gateway",
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_idle",
      "all_frames": true
    }
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "links@decdn.org",
      "strict_min_version": "128.0"
    }
  }
}
